{
  "name": "tarifesec",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:seed": "tsx drizzle/seed.ts",
    "test": "tsc --noEmit && tsx --test scraper/__tests__/*.test.ts",
    "db:seed:blog": "tsx drizzle/seed-blog.ts",
    "test:scraper": "tsx --test scraper/__tests__/*.test.ts",
    "scrape": "tsx scraper/index.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "pg": "^8.13.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
