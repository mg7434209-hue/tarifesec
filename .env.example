# PostgreSQL — Railway PostgreSQL servisi otomatik inject eder
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Ortam: development | production
NODE_ENV=development

# Admin paneli şifresi — ZORUNLU.
# Tanımlı değilse /api/admin uçları tamamen kapalı çalışır (fail-closed).
ADMIN_SECRET=degistir-uzun-rastgele-bir-deger

# Ziyaretçi sayacı taban değeri (gösterilen toplam = base + gerçek sayaç)
VISITOR_BASE=1000

# Site kök adresi (sitemap/canonical üretimi için)
SITE_URL=https://www.tarifesec.net.tr
